SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:5173
PORT=3000
# CORS restricted to APP_URL. No Fly.io or Twilio.
# Optional comma-separated trusted web application origins; never use wildcard.
ALLOWED_ORIGINS=
# Set to exact number of trusted reverse proxies only when deployed.
TRUST_PROXY_HOPS=0

# Optional server-only Stripe credential. Leave empty until configured.
STRIPE_SECRET_KEY=


STRIPE_WEBHOOK_SECRET=
STRIPE_EVENT_MODE=test

# JSON array of approved plan IDs and corresponding Stripe Price IDs.
STRIPE_CHECKOUT_PLANS=[]

# Local development only; production requires shared mode and identical secret on every replica.
IDENTITY_RATE_MODE=local
# IDENTITY_RATE_SECRET=generate-a-random-server-only-secret
