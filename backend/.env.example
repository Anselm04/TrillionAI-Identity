SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:5173
PORT=3000
# CORS restricted to APP_URL. No Fly.io or Twilio.
