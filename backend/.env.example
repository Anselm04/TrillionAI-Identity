# Supabase project URL and public/publishable key (not service-role key)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Set ONLY after verifying the owner's real account by completing registration.
OWNER_SUPABASE_USER_ID=
PORT=8080
NODE_ENV=development
